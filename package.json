{
  "name": "bluehorse-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PWA de entrenamiento adaptativo sobre el equipamiento real del gimnasio Blue Horse",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bh/web",
    "build": "npm run build --workspace @bh/web",
    "preview": "npm run preview --workspace @bh/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/domain/src/database.types.ts",
    "db:ruleset": "node scripts/push-ruleset.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@vitest/coverage-v8": "5.0.0",
    "lefthook": "2.1.12",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
