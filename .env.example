# Copiá este archivo a `.env` y completá los valores. `.env` está en .gitignore.
#
# Los valores locales salen de `npm run db:start` (la CLI los imprime al arrancar).
# Los de producción están en el panel de Supabase → Project Settings → API.

# URL del proyecto Supabase. Local: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Clave pública (anon). Es segura en el cliente: el acceso lo controla RLS, no la clave.
VITE_SUPABASE_ANON_KEY=

# NUNCA pongas acá la service_role key. No lleva prefijo VITE_ justamente porque
# no debe llegar nunca al navegador. Si necesitás una tarea con privilegios,
# va en una Edge Function con su propio secreto.

# --- Entrar con Google ---
#
# Salen de Google Cloud Console → APIs y servicios → Credenciales → ID de cliente
# de OAuth 2.0, tipo "Aplicación web". Ver docs/08-google-oauth.md para el paso a paso.
#
# El client ID es público (viaja en la URL de autorización). El secreto no: por eso
# los dos viven acá y config.toml los lee con `env(...)`, en vez de tenerlos escritos.
#
# La CLI de Supabase lee este archivo al arrancar. Después de cambiarlos hay que
# correr `npm run db:stop && npm run db:start` — no alcanza con reiniciar la app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
